{
  "name": "@alwansan/android-builder-mcp",
  "version": "0.1.0",
  "description": "MCP server for building Android APKs on arm64 (Termux + proot-distro + Ubuntu)",
  "type": "module",
  "bin": {
    "android-builder-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "install.sh",
    "scripts",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alwansan/android-builder-mcp"
  },
  "keywords": [
    "android",
    "apk",
    "mcp",
    "opencode",
    "arm64",
    "termux",
    "proot-distro"
  ]
}
